{
  "manifest_version": 3,
  "name": "Liney Connector",
  "version": "0.1.0",
  "description": "Connect Liney Web App to LINE endpoints from the user's browser without a central Worker relay.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": [
    "https://liney.namnarak.in.th/*",
    "https://legy.line-apps.com/*",
    "https://ga2.line.naver.jp/*",
    "https://ga2.line-apps.com/*",
    "https://gw.line.naver.jp/*",
    "https://obs.line-scdn.net/*",
    "https://dl.profile.line-cdn.net/*",
    "https://profile.line-scdn.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://liney.namnarak.in.th/app*", "https://liney.pages.dev/app*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Liney Connector",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/liney-logo.png"
    }
  },
  "icons": {
    "16": "icons/liney-logo.png",
    "32": "icons/liney-logo.png",
    "48": "icons/liney-logo.png",
    "128": "icons/liney-logo.png"
  }
}
