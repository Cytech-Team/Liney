pkgname=liney
pkgver=0.1.0
pkgrel=1
pkgdesc='Independent unofficial LINE desktop client for Linux'
arch=('x86_64')
url='https://github.com/Cytech-Team/Liney'
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libappindicator-gtk3'
)
makedepends=(
  'bun'
  'rust'
  'cargo'
  'pkgconf'
  'librsvg'
  'patchelf'
  'git'
  'curl'
  'file'
  'alsa-lib'
  'pipewire'
)
optdepends=(
  'alsa-lib: native microphone, speaker and call-tone capability'
  'pipewire: preferred screen sharing through XDG Desktop Portal'
  'xdg-desktop-portal: desktop-managed screen/window chooser'
  'wayland: direct Wayland screen-capture fallback'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Replace this with the release tarball checksum before publishing to AUR.
sha256sums=('SKIP')

build() {
  cd "$srcdir/Liney-$pkgver"
  bun install --frozen-lockfile
  bun run doctor
  bun test
  bun run lint
  bun run web:build

  local target
  target=$(rustc -vV | sed -n 's/^host: //p')
  LINEY_TARGET_TRIPLE="$target" scripts/build-sidecar.sh
  cargo build --release --locked --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "$srcdir/Liney-$pkgver"
  local target
  target=$(rustc -vV | sed -n 's/^host: //p')

  install -Dm755 src-tauri/target/release/liney "$pkgdir/usr/lib/liney/liney"
  install -Dm755 "src-tauri/binaries/liney-engine-$target" "$pkgdir/usr/lib/liney/liney-engine"
  install -Dm755 "src-tauri/binaries/liney-media-$target" "$pkgdir/usr/lib/liney/liney-media"
  install -Dm755 "src-tauri/binaries/liney-audio-$target" "$pkgdir/usr/lib/liney/liney-audio"
  install -Dm755 "src-tauri/binaries/liney-screen-$target" "$pkgdir/usr/lib/liney/liney-screen"
  install -Dm755 "src-tauri/binaries/liney-screen-wayland-$target" "$pkgdir/usr/lib/liney/liney-screen-wayland"
  install -Dm755 "src-tauri/binaries/liney-screen-x11-$target" "$pkgdir/usr/lib/liney/liney-screen-x11"
  install -Dm755 packaging/liney-launcher "$pkgdir/usr/bin/liney"
  install -Dm644 packaging/liney.desktop "$pkgdir/usr/share/applications/liney.desktop"
  install -Dm644 packaging/liney.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/liney.png"
  install -Dm644 README.md "$pkgdir/usr/share/doc/liney/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/liney/LICENSE"
  install -Dm644 branding/liney-logo.jpg "$pkgdir/usr/share/doc/liney/branding/liney-logo.jpg"
}
