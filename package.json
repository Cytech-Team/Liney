{
  "name": "liney",
  "private": true,
  "version": "0.1.3",
  "license": "LicenseRef-TLL-1.0",
  "type": "module",
  "scripts": {
    "doctor": "sh scripts/check-linux-deps.sh",
    "dev": "npm run electron:dev",
    "dev:web": "vite",
    "build": "npm run electron:build",
    "build:deb": "npm run electron:engine && npm run electron:web && npm run electron:helpers && electron-builder --linux deb",
    "build:appimage": "npm run electron:build:appimage",
    "engine:build": "npm run electron:engine",
    "web:dev": "vite",
    "web:build": "tsc -b && vite build",
    "web:preview": "vite preview",
    "lint": "oxlint",
    "test": "bun test",
    "test:unit": "bun test engine/*.test.ts",
    "verify:release": "npm run doctor && npm test && npm run lint && npm run electron:engine && npm run electron:web && git diff --check",
    "build:rpm": "npm run electron:engine && npm run electron:web && npm run electron:helpers && electron-builder --linux rpm",
    "release:local": "sh scripts/package-release.sh",
    "electron:engine": "bun build engine/main.ts --target=node --packages=external --outfile electron/dist/engine.mjs",
    "electron:web": "LINEY_DESKTOP_TARGET=electron npm run web:build",
    "electron:dev": "LINEY_DESKTOP_TARGET=electron electron .",
    "electron:build": "npm run electron:engine && npm run electron:web && npm run electron:helpers && electron-builder --linux AppImage deb rpm",
    "electron:build:appimage": "npm run electron:engine && npm run electron:web && npm run electron:helpers && electron-builder --linux AppImage",
    "electron:smoke": "LINEY_DISABLE_AUTO_RESTORE=1 LINEY_ELECTRON_SMOKE=1 electron .",
    "electron:helpers": "node scripts/electron-stage-helpers.mjs",
    "build:flatpak": "sh scripts/build-flatpak.sh"
  },
  "dependencies": {
    "@evex/linejs": "npm:@jsr/evex__linejs@3.5.0",
    "@tanstack/react-virtual": "^3.14.13",
    "electron-updater": "6.8.11",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "bun": "^1.4.4",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "description": "Independent unofficial LINE desktop client for Linux",
  "author": "Cytech Team Development",
  "repository": "https://github.com/Cytech-Team/Liney",
  "patchedDependencies": {
    "lucide-react@1.41.0": "patches/lucide-react@1.41.0.patch"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "dev.cytechteam.liney.electron-preview",
    "productName": "Liney Electron Preview",
    "asar": true,
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "electron/dist/engine.mjs",
      "branding/icons/128x128.png",
      "package.json",
      "!**/node_modules/.cache/**"
    ],
    "linux": {
      "category": "Network;InstantMessaging",
      "icon": "branding/icons",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "syncDesktopName": true,
      "maintainer": "Cytech Team Development"
    },
    "appImage": {
      "artifactName": "Liney-Electron-Preview-${version}-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "Liney-Electron-Preview-${version}-${arch}.deb"
    },
    "rpm": {
      "artifactName": "Liney-Electron-Preview-${version}-${arch}.rpm"
    },
    "publish": null,
    "asarUnpack": [
      "electron/dist/engine.mjs",
      "electron/native/**",
      "node_modules/**"
    ]
  },
  "desktopName": "dev.cytechteam.liney.electron-preview"
}
