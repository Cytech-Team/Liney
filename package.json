{
  "name": "liney",
  "private": true,
  "version": "0.1.0",
  "license": "LicenseRef-TLL-1.0",
  "type": "module",
  "scripts": {
    "doctor": "sh scripts/check-linux-deps.sh",
    "dev": "sh scripts/tauri-static-dev.sh",
    "dev:web": "sh scripts/tauri-dev.sh",
    "build": "sh scripts/tauri-build.sh",
    "build:deb": "sh scripts/tauri-build.sh --bundles deb",
    "build:appimage": "sh scripts/tauri-build.sh --bundles appimage",
    "engine:build": "sh scripts/build-sidecar.sh",
    "web:dev": "vite",
    "web:build": "tsc -b && vite build",
    "web:preview": "vite preview",
    "lint": "oxlint",
    "test": "bun test",
    "test:unit": "bun test engine/*.test.ts",
    "verify:release": "bun run doctor && bun test && bun run lint && bun run web:build && bun run engine:build && cargo build --release --manifest-path src-tauri/Cargo.toml && git diff --check",
    "build:rpm": "sh scripts/tauri-build.sh --bundles rpm",
    "release:local": "sh scripts/package-release.sh",
    "extension:zip": "sh scripts/package-extension.sh"
  },
  "dependencies": {
    "@evex/linejs": "npm:@jsr/evex__linejs@3.5.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-shell": "~2",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "description": "Independent unofficial LINE desktop client for Linux",
  "author": "Cytech Team Development",
  "repository": "https://github.com/Cytech-Team/Liney"
}
