export global Theme {
    in-out property <bool> dark: true;
    out property <brush> background: dark ? #101318 : #edf2f6;
    out property <brush> surface: dark ? #15191f : #ffffff;
    out property <brush> raised: dark ? #1a2027 : #f7f9fb;
    out property <brush> hover: dark ? #20262e : #f1f4f7;
    out property <brush> border: dark ? #252c35 : #e7ebf0;
    out property <brush> text: dark ? #edf2f7 : #182033;
    out property <brush> muted: dark ? #9aa5b5 : #7b8799;
    out property <brush> subtle: dark ? #6f7b8c : #a4adba;
    out property <brush> mine: dark ? #183a29 : #dff7e9;
    out property <brush> accent-soft: dark ? #173a29 : #e8fbf1;
    out property <brush> accent: #20c96e;
    out property <brush> nav: #131d2a;
    out property <brush> nav-hover: #24364b;
}
